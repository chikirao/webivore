{
  "name": "webivore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build && node scripts/prepare-pages.mjs",
    "build:pages": "npm run build",
    "test": "tsx --test tests/*.test.ts",
    "qa:free-release": "node tests/free-release-qa.mjs",
    "cf:install": "npm --prefix cloudflare install",
    "cf:check": "npm --prefix cloudflare run check",
    "cf:test": "npm --prefix cloudflare test",
    "cf:verify": "npm run cf:check && npm run cf:test",
    "cf:dev": "npm --prefix cloudflare run dev",
    "cf:deploy": "npm --prefix cloudflare run deploy",
    "cf:kv:create": "npm --prefix cloudflare exec wrangler -- kv namespace create WEBIVORE_SNAPSHOTS --binding SNAPSHOTS --update-config --cwd cloudflare"
  },
  "dependencies": {
    "@fontsource/tektur": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "express": "^5.1.0",
    "playwright": "^1.55.0",
    "pngjs": "^7.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "linkedom": "^0.18.13",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
